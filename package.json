{
	"name": "n8n-nodes-ffmpeg-thumbnailer",
	"version": "0.1.0",
	"description": "n8n node that generates a thumbnail image from a video using FFmpeg",
	"keywords": [
		"n8n-community-node-package",
		"ffmpeg",
		"thumbnail",
		"video"
	],
	"license": "MIT",
	"main": "dist/nodes/FfmpegThumbnailer/FfmpegThumbnailer.node.js",
	"scripts": {
		"build": "tsc && cp nodes/FfmpegThumbnailer/*.svg dist/nodes/FfmpegThumbnailer/",
		"dev": "tsc --watch",
		"test": "npm run build && node test/smoke.js"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [],
		"nodes": [
			"dist/nodes/FfmpegThumbnailer/FfmpegThumbnailer.node.js"
		]
	},
	"dependencies": {
		"n8n-workflow": "*"
	},
	"devDependencies": {
		"@types/node": "^20.11.0",
		"typescript": "^5.4.0"
	}
}
