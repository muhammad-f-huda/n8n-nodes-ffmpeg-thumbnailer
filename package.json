{
	"name": "n8n-nodes-ffmpeg-thumbnailer",
	"version": "0.1.0",
	"description": "n8n nodes that generate video thumbnails and resize images (including HEIC) using FFmpeg",
	"keywords": [
		"n8n-community-node-package",
		"ffmpeg",
		"thumbnail",
		"video",
		"image",
		"heic"
	],
	"license": "MIT",
	"main": "dist/nodes/FfmpegThumbnailer/FfmpegThumbnailer.node.js",
	"scripts": {
		"build": "tsc && cp nodes/FfmpegThumbnailer/*.svg dist/nodes/FfmpegThumbnailer/ && cp nodes/FfmpegImage/*.svg dist/nodes/FfmpegImage/",
		"dev": "tsc --watch",
		"test": "npm run build && node test/smoke.js"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [],
		"nodes": [
			"dist/nodes/FfmpegThumbnailer/FfmpegThumbnailer.node.js",
			"dist/nodes/FfmpegImage/FfmpegImage.node.js"
		]
	},
	"dependencies": {
		"heic-decode": "^2.1.0",
		"n8n-workflow": "*"
	},
	"devDependencies": {
		"@types/node": "^20.11.0",
		"typescript": "^5.4.0"
	}
}
